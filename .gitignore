.DS_Store
.venv/
__pycache__/

# TLS cert/key and paired-device tokens are generated locally on first run —
# never commit private key material or pairing secrets
cert.pem
key.pem
paired_devices.json

# Node / Raycast extension
air-mouse/node_modules/
air-mouse/.raycast-swift-build/
air-mouse/.swiftpm/
air-mouse/compiled_raycast_swift/
air-mouse/compiled_raycast_rust/
air-mouse/raycast-env.d.ts

# Swift menu bar app build output
menubar/.build/
menubar/AirMouseBar.app/
menubar/*.dmg
menubar/*.dmg.zip

# Release signing material — never commit. The Sparkle EdDSA private key signs
# updates; anyone holding it can ship a binary that inherits users' Accessibility
# permission. Belongs in CI secrets only (see ADR-0009).
*.p12
*.p8
eddsa_priv
sparkle_private*.pem
